# 中转驿 — 与 muzhi 同库同 secret 才能对接账号
NODE_ENV=development
APP_URL=http://localhost:3000
# 与 muzhi 同 Atlas、同 database（读它的 Session/User 表）
MONGODB_URI=mongodb+srv://.../muzhi_knowledge
# 必须与 muzhi 完全一致（hash session token 用 ${AUTH_SECRET}:${token}）
AUTH_SECRET=replace-with-same-as-muzhi-at-least-32-chars
SESSION_COOKIE_NAME=muzhi_session
SESSION_COOKIE_DOMAIN=.zmzai.cloud
RELAY_DEFAULT_UPSTREAM_TIMEOUT_MS=60000
# 随机至少 32 位；服务器 cron 用它调用过期预留清算端点
RELAY_INTERNAL_CRON_SECRET=replace-with-a-random-secret-at-least-32-chars
# Sandbox 内部调用 Relay 的共享服务密钥。仅服务端使用，生产环境必须设置。
RELAY_SANDBOX_SERVICE_SECRET_CURRENT=replace-with-a-random-secret-at-least-32-chars
# 轮换窗口内可选，完成切换后删除。
# RELAY_SANDBOX_SERVICE_SECRET_PREVIOUS=
# Agent Runtime 内部调用 Relay 的共享服务密钥。它独立于 Sandbox 服务密钥，生产环境必须设置。
RELAY_AGENT_SERVICE_SECRET_CURRENT=replace-with-a-different-random-secret-at-least-32-chars
# 轮换窗口内可选，完成切换后删除。
# RELAY_AGENT_SERVICE_SECRET_PREVIOUS=
# Agent 需要「用户本机能力」（本机文件/命令/通知）时，经 zmzai-bridge 下发到桌面客户端。
# 生产环境必须设置；不填时回退到 bridge 仓库的 dev 默认值（仅限本机联调）。
RELAY_BRIDGE_URL=http://127.0.0.1:8787
RELAY_BRIDGE_TOKEN=replace-with-bridge-internal-api-token
# 人工收款配置：二维码建议使用受控的 HTTPS 图片地址；不填则页面显示待配置。
NEXT_PUBLIC_PAYMENT_QR_URL=https://example.com/your-payment-qr.png
NEXT_PUBLIC_PAYMENT_ACCOUNT_NAME=你的收款账户名称
NEXT_PUBLIC_PAYMENT_NOTICE=付款备注填写订单号，完成付款后提交。
NEXT_PUBLIC_SUPPORT_WECHAT=请填写牧之微信号
# 可选：JSON 覆盖默认额度包。creditMicros 是内部精确记账单位，1,000,000 micros = ¥8；paymentAmountFen=人民币分。
# RELAY_WALLET_PRODUCTS_JSON=[{"id":"starter","name":"入门额度 · ¥8","creditMicros":1000000,"paymentAmountFen":800}]
# DeepSeek 官方渠道 API Key。npm run seed:deepseek 用它把渠道与价目写入 Mongo；生产环境必须设置。
DEEPSEEK_API_KEY=sk-...

# 遥测：usage 事件推送到 zmzai-billing /api/v1/ingest（未配置时静默跳过，不阻塞计费）
BILLING_INGEST_URL=
BILLING_INGEST_KEY=
